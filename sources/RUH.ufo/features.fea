languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn CAT;
@TOP_MARKS = [uni0304 acutecomb gravecomb uni0302 uni0308 tildecomb uni030A uni030C uni0306 uni0307 uni030B];
lookup RemoveSoftDot { lookupflag UseMarkFilteringSet @TOP_MARKS; sub i' @TOP_MARKS by dotlessi; sub j' @TOP_MARKS by uni0237; sub iogonek' @TOP_MARKS by iogonek.dotless; } RemoveSoftDot;
feature ccmp { lookup RemoveSoftDot; } ccmp;
feature tnum { sub zero by zero.tnum; sub one by one.tnum; sub two by two.tnum; sub three by three.tnum; sub four by four.tnum; sub five by five.tnum; sub six by six.tnum; sub seven by seven.tnum; sub eight by eight.tnum; sub nine by nine.tnum; } tnum;
feature locl { script latn; language CAT; sub l periodcentered' l by periodcentered.loclCAT; sub L periodcentered' L by periodcentered.loclCAT.case; } locl;
feature kern {
pos A V -65;
pos V A -65;
pos A W -55;
pos W A -55;
pos A Y -70;
pos Y A -70;
pos T A -55;
pos A T -45;
pos T o -40;
pos T a -40;
pos T e -35;
pos Y o -50;
pos Y e -45;
pos W a -25;
pos V o -40;
pos L T -35;
pos L Y -50;
pos F A -30;
pos P A -35;
pos T y -25;
pos r period -25;
pos T period -50;
pos V period -65;
pos Y period -65;
} kern;
